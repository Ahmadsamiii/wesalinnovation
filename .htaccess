# ==========================================================================
#  وصال — إعدادات Apache لجذر الموقع
#
#  ملاحظة: كان هذا الملف قبل الإصلاح نسخة من api/db.php حُفظت باسم .htaccess
#  بالخطأ، وهو ما يجعل Apache يرفض الشجرة كاملة بخطأ 500.
# ==========================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks
ServerSignature Off


# --------------------------------------------------------------------------
#  حجب الملفات التي لا يجوز تقديمها للمتصفح
# --------------------------------------------------------------------------

# أي ملف يبدأ بنقطة: .htaccess و .env و .git وغيرها
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# المخطط والتوثيق ونماذج الإعدادات والنسخ الاحتياطية
<FilesMatch "\.(sql|md|log|ini|bak|old|swp|dist)$">
  Require all denied
</FilesMatch>

# نموذج الإعدادات — ليس فيه أسرار، لكن لا داعي لنشر بنية الإعدادات
<Files "config.example.php">
  Require all denied
</Files>


# --------------------------------------------------------------------------
#  ترويسات الأمان
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # الميكروفون مسموح للنطاق نفسه لأن البحث الصوتي يعتمد على SpeechRecognition
  Header always set Permissions-Policy "microphone=(self), geolocation=(), camera=(), payment=(), usb=()"

  # 'unsafe-inline' مطلوب مؤقتاً: السكربت والأنماط ومعالجات onclick مضمّنة في
  # index.html. تشديد هذه السياسة يتطلّب إخراجها إلى ملفات منفصلة أولاً.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"

  # HSTS — يُرسل على اتصالات HTTPS فقط
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # لا تخزّن ردود الواجهة البرمجية مؤقتاً
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>


# --------------------------------------------------------------------------
#  منع تنفيذ السكربتات داخل مجلد المرفوعات
#  خط دفاع ثانٍ: auth.php يتحقق أصلاً من نوع الصورة ويشتقّ الامتداد منه.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.+\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|htaccess|htpasswd)$ - [F,L,NC]

  # رابط دعوة النسخة التجريبية — /invite/{token} يصل بالمدعو لمستلم الدعوات
  RewriteRule ^invite/([a-f0-9]{40})$ api/invite-redeem.php?token=$1 [L,QSA]
</IfModule>


# --------------------------------------------------------------------------
#  أنواع MIME — بعض الاستضافات لا تعرف woff2 و webp افتراضياً
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2  .woff2
  AddType font/otf    .otf
  AddType image/webp  .webp
  AddType image/x-icon .ico
</IfModule>


# --------------------------------------------------------------------------
#  الضغط — النصوص فقط، فالخطوط والصور مضغوطة أصلاً
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# --------------------------------------------------------------------------
#  التخزين المؤقت
#  index.html لا يُخزَّن: هو التطبيق كله، ونسخة قديمة تعني مستخدماً عالقاً
#  على إصدار سابق. الأصول الثابتة تُخزَّن طويلاً.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault               "access plus 1 hour"
  ExpiresByType text/html      "access plus 0 seconds"
  ExpiresByType font/woff2     "access plus 1 year"
  ExpiresByType font/otf       "access plus 1 year"
  ExpiresByType image/png      "access plus 30 days"
  ExpiresByType image/webp     "access plus 30 days"
  ExpiresByType image/x-icon   "access plus 30 days"
  ExpiresByType image/svg+xml  "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
