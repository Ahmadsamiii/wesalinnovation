APP_NAME="مساحة عمل وصال"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite للتطوير المحلي فقط. الإنتاج: قاعدة MySQL مستقلة عن قاعدة وصال العامة
# (عزل البيانات المالية والعقود) — DB_CONNECTION=mysql مع القيم أدناه.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=wesal_workspace
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# بيانات المنشأة في رأس الفاتورة، وحدود الاعتماد المالي (config/workspace.php)
COMPANY_NAME="وصال الابتكار"
COMPANY_VAT_NUMBER=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
VAT_RATE=15
PO_EXECUTIVE_THRESHOLD=50000
INVOICE_PAYMENT_TERMS_DAYS=30

# قاعدة بيانات المنصة العامة — قراءة فقط، لإحصاءات الذكاء الاصطناعي وتنبيهات
# الأسئلة الحساسة. اتركها فارغة إن لم تُربط بعد.
PLATFORM_DB_HOST=
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=
PLATFORM_DB_USERNAME=
PLATFORM_DB_PASSWORD=
